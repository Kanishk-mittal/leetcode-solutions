#!/usr/bin/env python3
import os

def clean_binaries():
    """
    Deletes files that appear to be compiled C++ binaries.
    A file is considered a binary if it has no extension and there
    is a corresponding .cpp file with the same basename.
    """
    # Get all files in the current directory
    files = os.listdir('.')
    
    # Find all .cpp files
    cpp_files = {os.path.splitext(f)[0] for f in files if f.endswith('.cpp')}
    
    # Find and delete corresponding binaries
    deleted_count = 0
    for f in files:
        if os.path.isfile(f) and os.path.splitext(f)[1] == '' and os.path.splitext(f)[0] in cpp_files:
            try:
                os.remove(f)
                print(f"Deleted binary file: {f}")
                deleted_count += 1
            except OSError as e:
                print(f"Error deleting file {f}: {e}")
    
    if deleted_count == 0:
        print("No binary files found to delete.")
    else:
        print(f"\nDeleted {deleted_count} binary files.")

if __name__ == "__main__":
    clean_binaries()
